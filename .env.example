# Copy this file to .env and fill in local values. Never commit .env.
# Everything here is read by the API server only; none of it belongs in the mobile app.

# Gemini key for AI guidance (server only). Empty = AI routes return GEMINI_UNAVAILABLE.
GEMINI_API_KEY=

# Local API
PORT=3001
NODE_ENV=development

# PostgreSQL connection string (production, e.g. Supabase). Placeholder only: replace it,
# or leave DATABASE_URL empty to use the local SQLite database in development.
# Required when NODE_ENV=production. URL-encode special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# TLS to PostgreSQL: "require" (default; certificate verified) or "disable" (local
# development only; refused in production).
DATABASE_SSL=require
# CA certificate for providers whose certificate is not publicly trusted (Supabase):
# the PEM text with \n line breaks, or a path to the PEM file. Leave empty otherwise.
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=
# Maximum pooled PostgreSQL connections (1-50).
DATABASE_POOL_MAX=10

# Browser origins allowed by CORS (comma-separated, https:// only in production).
# Native mobile requests send no Origin header and are not affected.
CORS_ALLOWED_ORIGINS=

# Reverse-proxy hops in front of the API (a number such as 1) or false.
TRUST_PROXY=false

# Reject non-HTTPS API requests (except /health). Defaults to true in production.
ENFORCE_HTTPS=

# Optional development seed. Leave disabled unless you need a local test user.
# Only ever applies to the local SQLite database; ignored in production and for PostgreSQL.
# Values here are placeholders, not real accounts.
SEED_DEV_USER=false
SEED_DEV_EMAIL=your_dev_email_here
SEED_DEV_PASSWORD=your_dev_password_here

# Copy this file to .env and fill in local values. Never commit .env.

# Required for Gemini skin-issue analysis (server only).
GEMINI_API_KEY=your_gemini_api_key_here

# Local API
PORT=3001
NODE_ENV=development

# Browser origins allowed by CORS (comma-separated, https:// only in production).
# Native mobile requests send no Origin header and are not affected.
CORS_ALLOWED_ORIGINS=

# Reverse-proxy hops in front of the API (a number such as 1) or false.
TRUST_PROXY=false

# Reject non-HTTPS API requests (except /health). Defaults to true in production.
ENFORCE_HTTPS=

# Optional development seed. Leave disabled unless you need a local test user.
# Do not enable in production. Values here are placeholders, not real accounts.
SEED_DEV_USER=false
SEED_DEV_EMAIL=your_dev_email_here
SEED_DEV_PASSWORD=your_dev_password_here

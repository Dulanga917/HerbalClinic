# Copy to server/.env or use the repository-root .env file.

GEMINI_API_KEY=your_gemini_api_key_here
PORT=3001
NODE_ENV=development

# Browser origins allowed by CORS (comma-separated, https:// only in production).
# Native mobile requests send no Origin header and are not affected.
# Leave empty in production unless a web client needs access.
CORS_ALLOWED_ORIGINS=

# Number of reverse-proxy hops in front of the API (for example 1 behind one load
# balancer), or false when the API is exposed directly. Needed for correct client IPs
# in rate limiting and for HTTPS detection.
TRUST_PROXY=false

# Reject non-HTTPS API requests (except /health). Defaults to true when NODE_ENV=production.
ENFORCE_HTTPS=

SEED_DEV_USER=false
SEED_DEV_EMAIL=your_dev_email_here
SEED_DEV_PASSWORD=your_dev_password_here

# Copy to server/.env or use the repository-root .env file. Never commit real values.
# On Render, set these as environment variables instead of using a file.

# Gemini key for AI guidance. Empty = AI routes return GEMINI_UNAVAILABLE.
GEMINI_API_KEY=
PORT=3001
NODE_ENV=development

# PostgreSQL connection string (production, e.g. the Supabase session pooler).
# Placeholder only: replace it, or leave DATABASE_URL empty to use the local SQLite
# database in development. Required when NODE_ENV=production.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# TLS to PostgreSQL: "require" (default; the server certificate is verified) or
# "disable" (local development only; refused when NODE_ENV=production).
DATABASE_SSL=require
# CA certificate used to verify the database server, needed for Supabase (download it
# from the project's Database settings). Either the PEM text with \n line breaks or a
# path to the PEM file (for example a Render secret file under /etc/secrets/).
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=
# Maximum pooled PostgreSQL connections (1-50).
DATABASE_POOL_MAX=10

# Browser origins allowed by CORS (comma-separated, https:// only in production).
# Native mobile requests send no Origin header and are not affected.
# Leave empty in production unless a web client needs access.
CORS_ALLOWED_ORIGINS=

# Number of reverse-proxy hops in front of the API (1 on Render), or false when the API
# is exposed directly. Needed for correct client IPs in rate limiting and for HTTPS
# detection. Production with ENFORCE_HTTPS refuses to start while this is false.
TRUST_PROXY=false

# Reject non-HTTPS API requests (except /health). Defaults to true when NODE_ENV=production.
ENFORCE_HTTPS=

# Development-only seed account for the local SQLite database. Ignored when
# NODE_ENV=production and never applied to PostgreSQL. Placeholders, not real accounts.
SEED_DEV_USER=false
SEED_DEV_EMAIL=your_dev_email_here
SEED_DEV_PASSWORD=your_dev_password_here
